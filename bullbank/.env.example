# BullBank frontend configuration.
# Copy to .env and fill in. Values come from pool-addresses.json, written by
# init-pool-bullbank.ts after the pool is created.

# Absolute site URL, no trailing slash. Baked into the share-card meta tags,
# which scrapers will not resolve from a relative path.
VITE_SITE_URL=https://bullbank.lol9944gg.workers.dev

# RPC. The public endpoint is rate limited and blocks some browser origins —
# use a real provider (Helius / QuickNode / Triton) with a domain-restricted key.
VITE_RPC_URL=https://api.mainnet-beta.solana.com
VITE_CLUSTER=mainnet-beta

VITE_PROGRAM_ID=BLj7FScr8f57ygqFGJJtZ3sVRCx7C7gUQihyUWYptBYq
VITE_TOKEN_MINT=REPLACE_WITH_BULLBANK_MINT
VITE_POOL_PDA=REPLACE_WITH_POOL_PDA
VITE_STAKE_VAULT=REPLACE_WITH_STAKE_VAULT
VITE_REWARD_VAULT=REPLACE_WITH_REWARD_VAULT

# pump.fun tokens use 6 decimals.
VITE_TOKEN_DECIMALS=6

# Gates the contract address and all reserve/emission figures. Keep false until
# the token is actually live — otherwise the site shows devnet numbers as if real.
VITE_LAUNCHED=false

# Public proof links. Each shows an honest "not published yet" state until set.
VITE_SOURCE_URL=
VITE_CRANK_LOG_URL=
VITE_AUDIT_URL=
VITE_CRANK_INTERVAL_HOURS=6

# Share of supply the launchpad gives to $ANSEM holders.
VITE_AIRDROP_PERCENT=3
