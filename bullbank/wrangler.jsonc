{
  // Static site plus one server route.
  //
  // `main` handles /rpc (see worker/index.ts — it keeps the RPC key out of the
  // browser). Everything else is served from the Vite build through the ASSETS
  // binding.
  "name": "bullbank",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The site uses hash routing, so every real URL is "/". This only matters
    // for a mistyped path, which gets the app rather than a bare 404.
    "not_found_handling": "single-page-application",
    // Without this the asset layer answers /rpc with index.html — SPA handling
    // matches any unknown path — and the Worker never runs.
    "run_worker_first": ["/rpc", "/rpc/*"]
  }
}
