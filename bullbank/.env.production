# Deployed build configuration.
#
# NOT A SECRET STORE. Vite compiles every VITE_ value into the JavaScript
# bundle, where anyone can read it in devtools. Never put an RPC key, an API
# token or a keypair in this file — use the public endpoint instead, and if a
# provider key is ever genuinely needed, restrict it to the site domain.
#
# Pre-launch: mainnet cluster with no pool addresses yet. Nothing is read from
# chain and nothing is shown that could be mistaken for live data — the site is
# an information page until the token exists. Filling the addresses in at launch
# is what turns the app on.

VITE_SITE_URL=https://bullbank.win

VITE_RPC_URL=https://api.mainnet-beta.solana.com
VITE_CLUSTER=mainnet-beta

VITE_PROGRAM_ID=
VITE_TOKEN_MINT=
VITE_POOL_PDA=
VITE_STAKE_VAULT=
VITE_REWARD_VAULT=

VITE_TOKEN_DECIMALS=6

# Gates the contract address and every reserve figure. Stays false until the
# mint is live on mainnet and the reserve is funded.
VITE_LAUNCHED=false

VITE_SOURCE_URL=https://github.com/Szeberr/bullbank
VITE_CRANK_LOG_URL=https://github.com/Szeberr/bullbank/actions
VITE_AUDIT_URL=
VITE_CRANK_INTERVAL_HOURS=6
VITE_AIRDROP_PERCENT=3
